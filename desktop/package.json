{
  "name": "proday-desktop",
  "version": "1.0.0",
  "description": "ProDay - Application PC Windows & Mac",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "export:app": "cd .. && npx expo export -p web --output-dir desktop/app-dist",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder -mw",
    "pack:win": "electron-packager . ProDay --platform=win32 --arch=x64 --out=dist --overwrite",
    "zip:win": "cd dist/win-unpacked && zip -r ../ProDay-Windows-PC.zip ."
  },
  "author": "ProDay",
  "license": "UNLICENSED",
  "dependencies": {
    "electron-serve": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.proday.desktop",
    "productName": "ProDay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app-dist/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ProDay"
    }
  }
}
