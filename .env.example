# Copier vers .env et remplir avec la console Firebase (Projet ProDay)
EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# EAS / push Expo (expo.dev → projet → Project ID)
EXPO_PUBLIC_EAS_PROJECT_ID=

# OAuth Google (Firebase Console → Authentication → Google)
# Web client : Firebase / Google Cloud (type « Application Web ») — requis pour Firebase Auth
# iOS client : Google Cloud → Credentials → ID client OAuth « iOS » → bundle com.proday.app
#   Obligatoire sur iPhone : ne jamais réutiliser le Web client (erreur Custom scheme / WEB)
# Android client : type « Android » + SHA-1 du keystore
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# IAP — SKU App Store / Play Console (voir src/content/iapProducts.ts)
# club_pro : com.proday.app.club_pro.monthly | .yearly

# Région Cloud Functions par défaut (us-central1 si non défini — validateProfile, adminDeleteUser, etc.)
# EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1
# Callables europe-west1 (région passée explicitement dans le code, pas via cette variable) :
#   auth (verification/reset), sponsors push géo, activités IA, events équipe, bêta admin (Approuver/Renvoyer)

# E-mails Auth ProDay brandés (Cloud Functions + EmailJS)
# Activation côté serveur :
#   firebase functions:config:set auth.enabled=true auth.continue_url="https://proday75.fr"
#   firebase functions:config:set auth.emailjs_verification_template_id="template_xxx" auth.emailjs_password_reset_template_id="template_xxx"
# Clés EmailJS partagées sous beta.emailjs_* (voir docs/EMAILJS.md)
# Sans templates Auth EmailJS → fallback sendEmailVerification() / sendPasswordResetEmail() Firebase natif.
# Scripts de test : npm run auth:send-verification -- user@example.com

# Bêta iOS — TestFlight (Cloud Functions + site). Voir docs/BETA_IOS_LAUNCH.md
# firebase functions:config:set beta.testflight_url="https://testflight.apple.com/join/XXXXX"
# BETA_TESTFLIGHT_URL=https://testflight.apple.com/join/XXXXX
# Site Netlify : NEXT_PUBLIC_BETA_TESTFLIGHT_URL=… (affiché après le 11 août 2026 à 18 h)

# Stripe (Cloud Functions — clé secrète côté serveur uniquement)
# Uniquement paiements PONCTUELS (shop, cotisations club). PAS d’abonnements Billing.
# Déployer :
#   firebase functions:config:set stripe.secret_key="sk_test_..." stripe.webhook_secret="whsec_..."
# Webhook : https://REGION-PROJECT.cloudfunctions.net/stripeWebhook (événement checkout.session.completed)
# Carte test : 4242 4242 4242 4242

# RevenueCat — abonnements Pro récurrents (App Store / Google Play)
# Clés publiques SDK (app / EAS) :
#   EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
#   EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...
# Webhook Cloud Function (secret Authorization) :
#   REVENUECAT_WEBHOOK_AUTH=...   (dans functions/.env.<projectId>)
# Dashboard RC → Integrations → Webhooks :
#   URL https://REGION-PROJECT.cloudfunctions.net/revenueCatWebhook
#   Authorization header = même valeur que REVENUECAT_WEBHOOK_AUTH
# Produits = SKU `src/content/iapProducts.ts` ; entitlement recommandé : `pro`

# Mistral IA — vérification documents coach/agent/organisateur (Cloud Functions uniquement)
# firebase functions:config:set mistral.api_key="..."

# Compte administrateur (script local — mot de passe hors repo) :
# ADMIN_SETUP_EMAIL=proday.admin@gmail.com
# ADMIN_SETUP_PASSWORD=***
# npm run admin:setup
#
# Migration batch pôles Firestore (clé Admin SDK dans firebase/*-adminsdk-*.json) :
# npm run migrate:product-lines -- --dry-run
# npm run migrate:product-lines -- --confirm

# Compte joueur (script admin — mot de passe hors repo) :
# TEST_ACCOUNT_EMAIL=alfredgibeauahoussinou@gmail.com
# TEST_ACCOUNT_PASSWORD=***
# npm run test-account:setup

# Scores monde (API-Football / api-sports.io) — onglet Matchs supporter
# EXPO_PUBLIC_EXTERNAL_SCORES_MOCK=1          # fixtures démo locales (dev)
# EXPO_PUBLIC_EXTERNAL_SCORES_API_KEY=        # clé API-Football (dashboard api-sports.io)
# EXPO_PUBLIC_EXTERNAL_SCORES_API_URL=https://v3.football.api-sports.io

# Alertes tribune supporter — préférences sync Firestore (notification_preferences.supporter)
# Push via Expo/FCM ; fallback dev si pas de token (voir supporterNotifications.service.ts)

# Production / bêta : EXPO_PUBLIC_APP_ENV=production
# Puis : npm run beta:check && npm run firebase:deploy && npm run eas:build:production

# Vidéos fond connexion / déconnexion (MP4 vertical — clips IA, Firebase Storage…)
# Par défaut : assets/auth-greeting/*.mp4 (foot Mixkit, hors ligne)
# EXPO_PUBLIC_AUTH_GREETING_WELCOME_VIDEO_URL=
# EXPO_PUBLIC_AUTH_GREETING_GOODBYE_VIDEO_URL=
