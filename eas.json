{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_V3_SHELL": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_V3_SHELL": "1"
      }
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_V3_SHELL": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "alfred.ahoussinou@gmail.com",
        "appleTeamId": "F452SUU638",
        "ascAppId": "6801583755"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/google-play-service-account.json",
        "track": "internal"
      }
    },
    "testflight": {
      "extends": "production",
      "ios": {
        "appleId": "alfred.ahoussinou@gmail.com",
        "appleTeamId": "F452SUU638",
        "ascAppId": "6801583755"
      }
    }
  }
}
