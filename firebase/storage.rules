rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    function isSafeImageUpload() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    match /documents/{userId}/{fileName} {
      allow read: if request.auth != null
        && (isOwner(userId) || isAdmin());
      allow write: if isOwner(userId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)|application/pdf');
    }

    /**
     * Feuilles d'équipe déposées pour conversion PDF → tableau (pôle Coach).
     *
     * Écriture : l'auteur seul, PDF, 8 Mo max. **Lecture refusée aux clients** :
     * le document contient des données de mineurs et la Cloud Function
     * `extractSquadSheetText` y accède via le SDK Admin (qui ignore ces règles),
     * puis le supprime. Aucun écran n'a besoin de relire la feuille.
     */
    match /squad-sheets/{userId}/{fileName} {
      allow read: if false;
      allow write: if isOwner(userId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    /** Pièces devis sponsor — upload par le sponsor (uid dans le nom) ou admin */
    match /sponsor_quotes/{requestId}/{fileName} {
      allow read: if request.auth != null
        && (isAdmin() || fileName.matches('.*_' + request.auth.uid + '_.*'));
      allow write: if request.auth != null
        && (isAdmin() || fileName.matches('.*_' + request.auth.uid + '_.*'))
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)|application/pdf');
    }

    /** Coffre personnel — jamais public ; grantees via CF signed URL */
    match /personal_vault/{userId}/{fileName} {
      allow read: if request.auth != null
        && (isOwner(userId) || isAdmin());
      allow write: if isOwner(userId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)|application/pdf');
    }

    /** Coffre médical — propriétaire + admin uniquement au niveau Storage */
    match /medical_vault/{userId}/{fileName} {
      allow read: if request.auth != null
        && (isOwner(userId) || isAdmin());
      allow write: if isOwner(userId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)|application/pdf');
    }

    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    match /gallery/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isSafeImageUpload();
    }

    match /highlights/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId)
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    match /community_reels/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId)
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    match /feed/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isSafeImageUpload();
    }

    match /player_activity_thumbnails/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isSafeImageUpload();
    }

    match /voice_reflections/{userId}/{fileName} {
      allow read: if request.auth != null && (isOwner(userId) || isAdmin());
      allow write: if isOwner(userId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('audio/(m4a|mp4|aac|mpeg|wav|x-m4a|cafe)');
    }

    function isClubMemberOrStaff(clubId) {
      return request.auth != null && (
        request.auth.uid == clubId ||
        isAdmin() ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.profile.club_id == clubId
      );
    }

    /**
     * Périmètre financier club — miroir de `canManageClubFinance` côté Firestore.
     * Un coach rattaché au club n'a pas à lire les justificatifs de cotisation des familles.
     */
    function isClubFinanceManager(clubId) {
      return request.auth != null && (
        isAdmin()
        || request.auth.uid == clubId
        || (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'club'
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('profile', {}).get('club_id', '') == clubId
        )
      );
    }

    /** Justificatifs financiers (reçus, bordereaux) — chemin clubId, lecture staff financier. */
    match /club_finance_receipts/{clubId}/{fileName} {
      allow read: if isClubFinanceManager(clubId);
      allow write: if isClubFinanceManager(clubId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)|application/pdf');
    }

    /** Documents partagés équipe — staff club / adhérents (chemin clubId) */
    match /team_vault/{clubId}/{fileName} {
      allow read: if isClubMemberOrStaff(clubId);
      allow write: if isClubMemberOrStaff(clubId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)|application/pdf|text/plain');
    }

    // APK bêta — lecture publique (lien sur proday75.fr/beta/installer)
    match /beta/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
