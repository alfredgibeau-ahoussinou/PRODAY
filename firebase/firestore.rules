rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isStaff() {
      return isSignedIn()
        && userDoc(request.auth.uid).data.role in ['coach', 'club', 'organizer', 'agent', 'physio'];
    }

    function isFeedAuthorRole() {
      return userDoc(request.auth.uid).data.role in ['agent', 'physio', 'coach', 'organizer', 'club'];
    }

    function canPublishStages() {
      return userDoc(request.auth.uid).data.role in ['club', 'organizer', 'coach'];
    }

    function canPublishRecruitmentPost() {
      return userDoc(request.auth.uid).data.role
        in ['club', 'coach', 'agent', 'recruiter', 'organizer'];
    }

    function canParticipateWeeklyQuestion() {
      return userDoc(request.auth.uid).data.role in [
        'player', 'coach', 'club', 'agent', 'recruiter', 'organizer', 'physio', 'supporter'
      ];
    }

    /** Coach/club/organizer doivent être vérifiés ; recruteur et agent exemptés du diplôme. */
    function staffCanPublishSensitive() {
      let role = userDoc(request.auth.uid).data.role;
      return isVerifiedUser()
        || !(role in ['coach', 'club', 'organizer']);
    }

    function isMinorAccount() {
      return resource.data.get('parental_settings', {}).get('is_minor', false) == true;
    }

    function minorParentalProtected() {
      return !isMinorAccount()
        || (
          request.resource.data.get('parental_settings', {}).get('is_minor', true) != false
          && request.resource.data.get('parental_settings', {}).get('contacts_filter_enabled', true) != false
          && request.resource.data.get('parental_settings', {}).get('supervision_enabled', true) != false
        );
    }

    function canManageClubEntity() {
      return userDoc(request.auth.uid).data.role in ['club', 'coach', 'organizer', 'agent'];
    }

    function isThreadParticipant() {
      return resource.data.get('participant_ids', []).hasAny([request.auth.uid]);
    }

    function isMessageThreadParticipant(threadId) {
      return get(/databases/$(database)/documents/message_threads/$(threadId))
        .data.get('participant_ids', []).hasAny([request.auth.uid]);
    }

    function isValidThreadCreate() {
      return request.resource.data.participant_ids.size() == 2
        && request.resource.data.participant_ids.hasAny([request.auth.uid])
        && request.resource.data.participant_ids[0] != request.resource.data.participant_ids[1];
    }

    function canReadFeedPost() {
      return resource.data.audience == 'all'
        || (resource.data.audience == 'agents'
            && userDoc(request.auth.uid).data.role == 'agent');
    }

    function isStaffOrAdmin() {
      return isAdmin() || isStaff();
    }

    function isVerifiedUser() {
      return userDoc(request.auth.uid).data.get('is_verified', false) == true;
    }

    function hasSubmittedOnboardingDocuments() {
      let u = userDoc(request.auth.uid).data;
      let identityStatus = u.get('player_verification', {}).get('identity', {}).get('status', 'not_submitted');
      return u.get('onboarding_documents_submitted', false) == true
        || u.get('role', '') == 'sponsor'
        || (u.get('role', '') == 'player' && (identityStatus == 'pending' || identityStatus == 'verified'));
    }

    function canSendMessage() {
      let role = userDoc(request.auth.uid).data.role;
      return isSignedIn()
        && hasSubmittedOnboardingDocuments()
        && (isVerifiedUser() || role == 'physio');
    }

    function sponsorOfferMetricBump(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] == resource.data.get(field, 0) + 1;
    }

    function isSponsorOfferTrackingUpdate() {
      return isSignedIn()
        && (
          sponsorOfferMetricBump('views_count')
          || sponsorOfferMetricBump('clicks_count')
          || sponsorOfferMetricBump('leads_count')
        );
    }

    /**
     * Campagnes sponsor — aligné sur isSponsorCampaignAllowed (client).
     * Quotas d’offres actives restent contrôlés côté app / callable (pas de count() en rules).
     */
    function canCreateSponsorOffer() {
      let u = userDoc(request.auth.uid).data;
      let vs = u.get('verification_status', 'NOT_REQUIRED');
      return u.get('role', '') == 'sponsor'
        && u.get('sponsor_approved', false) == true
        && (vs == 'VERIFIED' || vs == 'NOT_REQUIRED')
        && request.resource.data.sponsor_uid == request.auth.uid;
    }

    function verificationFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'is_verified',
          'verification_status',
          'verification_date',
          'subscription_tier',
          'subscription_plan_id',
          'subscription_status',
          'subscription_period_end',
          'product_line',
          'sponsor_tier',
          'sponsor_territorial_approved_at',
          'sponsor_approved',
        ]);
    }

    /** Empêche l’escalade de privilèges ou le vol d’identité via auto-édition. */
    function ownerImmutableFieldsUnchanged() {
      return verificationFieldsUnchanged()
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('email', '') == resource.data.get('email', '');
    }

    /** Un joueur ne peut pas s’auto-assigner un club — seul staff (approve) ou admin. */
    function ownerClubIdUnchanged() {
      return resource.data.get('role', '') != 'player'
        || request.resource.data.get('profile', {}).get('club_id', null)
            == resource.data.get('profile', {}).get('club_id', null);
    }

    /** Un joueur ne peut jamais écrire ses stats saison depuis l'app client. */
    function ownerSeasonStatsUnchanged() {
      return resource.data.get('role', '') != 'player'
        || request.resource.data.get('profile', {}).get('season_stats', null)
            == resource.data.get('profile', {}).get('season_stats', null);
    }

    /** À la création, un joueur ne peut pas injecter de season_stats côté client. */
    function playerSeasonStatsEmptyOnCreate() {
      return request.resource.data.get('role', '') != 'player'
        || request.resource.data.get('profile', {}).get('season_stats', null) == null;
    }

    /** Coach/club du même club : patch stats saison joueur uniquement. */
    function canStaffWritePlayerSeasonStats() {
      let requester = userDoc(request.auth.uid).data;
      return isSignedIn()
        && requester.get('role', '') in ['coach', 'club']
        && resource.data.get('role', '') == 'player'
        && requester.get('profile', {}).get('club_id', '') != ''
        && requester.get('profile', {}).get('club_id', '')
            == resource.data.get('profile', {}).get('club_id', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile', 'updated_at'])
        && request.resource.data.get('profile', {}).diff(resource.data.get('profile', {})).affectedKeys()
            .hasOnly(['season_stats']);
    }

    /** Un mineur ne peut pas modifier les coordonnées tuteur enregistrées à l’inscription. */
    function minorGuardianContactUnchanged() {
      return !isMinorAccount()
        || (
          request.resource.data.get('parental_settings', {}).get('guardian_email', '')
            == resource.data.get('parental_settings', {}).get('guardian_email', '')
          && request.resource.data.get('parental_settings', {}).get('guardian_name', '')
            == resource.data.get('parental_settings', {}).get('guardian_name', '')
          && request.resource.data.get('parental_settings', {}).get('guardian_invite_code', '')
            == resource.data.get('parental_settings', {}).get('guardian_invite_code', '')
        );
    }

    function validProfileGender(gender) {
      return gender in ['men', 'women', 'minor'];
    }

    function ownerProfileGenderValid() {
      let profile = request.resource.data.get('profile', {});
      let gender = profile.get('gender', null);
      return gender == null || validProfileGender(gender);
    }

    function validUserRole(role) {
      return role in [
        'player', 'coach', 'club', 'agent', 'recruiter', 'organizer', 'sponsor', 'physio', 'supporter'
      ];
    }

    /** Profils visibles dans annuaires / reels (requêtes role + is_active). */
    function isPublicDiscoverableUser() {
      return resource.data.get('is_active', false) == true
        && resource.data.role in ['player', 'coach', 'club', 'agent', 'physio', 'organizer'];
    }

    function usersListQueryAllowed() {
      return isAdmin()
        || (request.query.limit <= 50
            && (isSignedIn() || isPublicDiscoverableUser()));
    }

    function userClubId() {
      let u = userDoc(request.auth.uid).data;
      return u.profile.club_id != null ? u.profile.club_id : request.auth.uid;
    }

    function isTournamentClubRegistration() {
      let clubUid = userClubId();
      let oldUids = resource.data.subscriber_uids;
      let newUids = request.resource.data.subscriber_uids;
      return resource.data.status == 'OPEN'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriber_uids'])
        && clubUid in newUids
        && !(clubUid in oldUids);
    }

    function isEventInvitee() {
      return resource.data.invitee_uids.hasAny([request.auth.uid]);
    }

    function isCarpoolCoordinationUpdate() {
      return isSignedIn()
        && isEventInvitee()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['carpool_slots', 'carpool_messages', 'updated_at']);
    }

    function guardianEmail() {
      return request.auth.token.get('email', '');
    }

    function isGuardianOfUser(data) {
      return isSignedIn()
        && guardianEmail() != ''
        && data.get('parental_settings', {}).get('is_minor', false) == true
        && (
          data.get('parental_settings', {}).get('guardian_email', '') == guardianEmail()
          || data.get('parental_settings', {}).get('guardian_email_secondary', '') == guardianEmail()
        );
    }

    function isCoGuardianInviteLink() {
      return isSignedIn()
        && guardianEmail() != ''
        && resource.data.get('parental_settings', {}).get('is_minor', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parental_settings', 'updated_at'])
        && request.resource.data.parental_settings.guardian_invite_code
            == resource.data.parental_settings.guardian_invite_code
        && request.resource.data.parental_settings.guardian_email
            == resource.data.parental_settings.guardian_email
        && request.resource.data.parental_settings.guardian_email_secondary == guardianEmail();
    }

    function guardianParentalPatchValid(prev, next) {
      let pPrev = prev.get('parental_settings', {});
      let pNext = next.get('parental_settings', {});
      return pNext.get('is_minor', false) == true
        && pNext.get('guardian_email', '') == pPrev.get('guardian_email', '')
        && pNext.get('supervision_enabled', true) == true
        && pNext.get('contacts_filter_enabled', true) == true;
    }

    function isGuardianParentalUpdate() {
      return isGuardianOfUser(resource.data)
        && verificationFieldsUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parental_settings', 'updated_at'])
        && guardianParentalPatchValid(resource.data, request.resource.data);
    }

    function isOwnerParentalRuntimeSync() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parental_runtime', 'updated_at'])
        && request.resource.data.parental_runtime.minutes_used is int
        && request.resource.data.parental_runtime.minutes_used >= 0
        && request.resource.data.parental_runtime.minutes_used <= 480
        && request.resource.data.parental_runtime.date is string;
    }

    match /users/{userId} {
      allow get: if isOwner(userId)
        || isAdmin()
        || isGuardianOfUser(resource.data)
        || isSignedIn();
      allow list: if usersListQueryAllowed();
      allow create: if isOwner(userId)
        && request.resource.data.verification_status in ['PENDING', 'NOT_REQUIRED']
        && validUserRole(request.resource.data.role)
        && playerSeasonStatsEmptyOnCreate()
        && ownerProfileGenderValid();
      allow update: if isAdmin()
        || canStaffWritePlayerSeasonStats()
        || isGuardianParentalUpdate()
        || isCoGuardianInviteLink()
        || (isOwner(userId)
            && ownerImmutableFieldsUnchanged()
            && ownerClubIdUnchanged()
            && ownerSeasonStatsUnchanged()
            && ownerProfileGenderValid()
            && minorGuardianContactUnchanged()
            && (minorParentalProtected() || isOwnerParentalRuntimeSync()));
      allow delete: if isAdmin();
    }

    match /users/{userId}/documents/{docId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isAdmin();
    }

    match /users/{userId}/subscription_usage/{periodId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/v3_brain/{docId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/v3_prefs/{docId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/health_program_progress/{programId} {
      allow read, write: if isOwner(userId);
    }

    /** Journal d'activité joueur — propriétaire ou staff recruteur */
    function canReadPlayerActivity() {
      return isSignedIn() && (
        resource.data.player_uid == request.auth.uid
        || userDoc(request.auth.uid).data.role in ['recruiter', 'club', 'coach', 'agent', 'organizer']
      );
    }

    /** Champs analyse IA — écriture serveur uniquement */
    function activityAnalysisFieldsUnchanged() {
      let forbidden = [
        'analysis_status',
        'analysis_summary_fr',
        'analysis_strengths',
        'analysis_improvements',
        'analysis_tactical_notes',
        'analysis_confidence',
        'analyzed_at',
      ];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(forbidden);
    }

    function validActivityCreateAnalysis() {
      let d = request.resource.data;
      return !('analysis_summary_fr' in d)
        && !('analysis_strengths' in d)
        && !('analysis_improvements' in d)
        && !('analysis_tactical_notes' in d)
        && !('analysis_confidence' in d)
        && !('analyzed_at' in d)
        && (!('analysis_status' in d) || d.analysis_status == 'pending_analysis');
    }

    match /player_activities/{activityId} {
      allow read: if canReadPlayerActivity();
      allow create: if isSignedIn()
        && request.resource.data.player_uid == request.auth.uid
        && request.resource.data.type in ['match', 'training', 'recovery']
        && request.resource.data.duration_min is int
        && request.resource.data.duration_min > 0
        && validActivityCreateAnalysis();
      allow update: if isSignedIn()
        && resource.data.player_uid == request.auth.uid
        && request.resource.data.player_uid == request.auth.uid
        && request.resource.data.type in ['match', 'training', 'recovery']
        && request.resource.data.duration_min is int
        && request.resource.data.duration_min > 0
        && activityAnalysisFieldsUnchanged();
      allow delete: if isSignedIn() && resource.data.player_uid == request.auth.uid;
    }

    match /messages/{msgId} {
      // Sponsors : création uniquement via Cloud Function (quota atomique).
      allow create: if canSendMessage()
        && request.resource.data.sender_id == request.auth.uid
        && userDoc(request.auth.uid).data.role != 'sponsor'
        && request.resource.data.thread_id is string
        && isMessageThreadParticipant(request.resource.data.thread_id)
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000;
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.thread_id is string
            && isMessageThreadParticipant(resource.data.thread_id));
      allow delete: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.organizer_uid == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.organizer_uid == request.auth.uid
            || isAdmin()
            || isTournamentClubRegistration());
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.organizer_uid == request.auth.uid);
    }

    match /friendly_matches/{matchId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /team_events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (request.resource.data.organizer_uid == request.auth.uid || isAdmin());
      allow update: if isSignedIn()
        && (
          isStaffOrAdmin()
          || isCarpoolCoordinationUpdate()
          || (
            resource.data.match_report_finalized_at == null
            && (
              resource.data.organizer_uid == request.auth.uid
              || (
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['rsvps', 'rsvp_notes', 'invitee_uids', 'updated_at'])
                && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny([
                    'attendance_marks',
                    'lineup',
                    'live_actions',
                    'player_match_stats',
                    'stats_applied_at',
                    'match_report_finalized_at',
                    'last_reminder_at',
                    'auto_reminder_sent_at',
                    'event_tasks',
                    'carpool_slots',
                    'carpool_messages'
                  ])
              )
            )
          )
        );
      allow delete: if isSignedIn()
        && (resource.data.organizer_uid == request.auth.uid || isAdmin());
    }

    match /carpool_offers/{offerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.driver_uid == request.auth.uid
        && request.resource.data.seats is int
        && request.resource.data.seats >= 1
        && request.resource.data.seats <= 8;
      allow update: if isSignedIn()
        && (
          resource.data.driver_uid == request.auth.uid
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passengers', 'updated_at'])
            && request.resource.data.driver_uid == resource.data.driver_uid
          )
        );
      allow delete: if isSignedIn() && resource.data.driver_uid == request.auth.uid;
    }

    match /team_payment_requests/{requestId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaffOrAdmin();
    }

    match /club_announcements/{announcementId} {
      allow read: if isSignedIn()
        && (isAdmin()
            || userDoc(request.auth.uid).data.profile.club_id == resource.data.club_id);
      allow create: if isStaffOrAdmin()
        && request.resource.data.author_uid == request.auth.uid
        && request.resource.data.club_id == userClubId();
      allow delete: if isAdmin()
        || (isStaffOrAdmin() && resource.data.club_id == userClubId());
      allow update: if false;
    }

    match /tournaments/{tournamentId}/matches/{matchId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn()
        && (
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizer_uid
            == request.auth.uid
          || isAdmin()
        );
    }

    match /sponsor_offers/{offerId} {
      allow read: if true;
      allow create: if isSignedIn() && (isAdmin() || canCreateSponsorOffer());
      allow update: if isSignedIn()
        && (
          isAdmin()
          || resource.data.sponsor_uid == request.auth.uid
          || isSponsorOfferTrackingUpdate()
        );
      allow delete: if isSignedIn()
        && (resource.data.sponsor_uid == request.auth.uid || isAdmin());
    }

    match /sponsor_profile_views/{viewId} {
      allow read: if isSignedIn()
        && (resource.data.sponsor_uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.sponsor_uid is string
        && request.resource.data.sponsor_uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['sponsor_uid', 'viewer_uid', 'created_at'])
        && request.resource.data.viewer_uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    /** Compteurs rate-limit — écriture serveur uniquement (callable trackSponsorEvent). */
    match /sponsor_tracking_rate/{docId} {
      allow read, write: if false;
    }

    match /sponsor_contributions/{contributionId} {
      allow read: if isSignedIn()
        && (resource.data.sponsor_uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.sponsor_uid == request.auth.uid
        && request.resource.data.amount_eur > 0;
      allow update, delete: if isAdmin();
    }

    match /sponsor_upgrade_requests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.sponsor_uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.sponsor_uid == request.auth.uid
        && request.resource.data.tier == 'territorial'
        && request.resource.data.status == 'pending'
        && request.resource.data.company is string
        && request.resource.data.company.size() > 0
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0;
      allow update: if isAdmin()
        && request.resource.data.sponsor_uid == resource.data.sponsor_uid
        && request.resource.data.tier == resource.data.tier
        && request.resource.data.company == resource.data.company
        && request.resource.data.city == resource.data.city
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.status in ['contacted', 'approved', 'rejected']
        && (
          (resource.data.status == 'pending'
            && request.resource.data.status in ['contacted', 'approved', 'rejected'])
          || (resource.data.status == 'contacted'
            && request.resource.data.status in ['approved', 'rejected'])
        );
      allow delete: if isAdmin();
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isSignedIn()
        && canManageClubEntity()
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.verified == false;
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.owner_uid == request.auth.uid
            && request.resource.data.owner_uid == resource.data.owner_uid
            && request.resource.data.verified == resource.data.verified);
      allow delete: if isAdmin();
    }

    function isClubStaffForClub(clubId) {
      return isSignedIn()
        && canManageClubEntity()
        && userDoc(request.auth.uid).data.get('profile', {}).get('club_id', '') == clubId;
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create: if isSignedIn()
        && canManageClubEntity()
        && request.resource.data.club_id is string
        && request.resource.data.name is string;
      allow update: if isAdmin()
        || (isSignedIn() && isClubStaffForClub(resource.data.club_id));
      allow delete: if isAdmin();
    }

    match /memberships/{membershipId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.player_uid == request.auth.uid)
        || (isSignedIn() && isClubStaffForClub(resource.data.club_id));
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.club_id is string
        && request.resource.data.team_id is string
        && request.resource.data.player_name is string
        && (
          request.resource.data.player_uid == request.auth.uid
          || (isClubStaffForClub(request.resource.data.club_id)
              && request.resource.data.player_uid != request.auth.uid)
        );
      allow update: if isAdmin()
        || (isSignedIn()
            && isClubStaffForClub(resource.data.club_id)
            && request.resource.data.club_id == resource.data.club_id
            && request.resource.data.player_uid == resource.data.player_uid
            && request.resource.data.status in ['active', 'rejected', 'suspended', 'left']);
      allow delete: if isAdmin();
    }

    match /recruitment_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && canPublishRecruitmentPost()
        && staffCanPublishSensitive()
        && request.resource.data.author_uid == request.auth.uid
        && request.resource.data.status == 'OPEN';
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.author_uid == request.auth.uid);
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.author_uid == request.auth.uid);
    }

    /** Alertes mercato joueur — sync pour push serveur */
    match /mercato_alerts/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    /** Commandes boutique ProDay Shop */
    match /shop_orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.buyer_uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /recruitment_applications/{appId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && (resource.data.player_uid == request.auth.uid
                || resource.data.post_author_uid == request.auth.uid));
      allow create: if isSignedIn()
        && request.resource.data.player_uid == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /club_funding_goals/{goalId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /message_threads/{threadId} {
      allow read: if isAdmin() || (isSignedIn() && isThreadParticipant());
      allow create: if isSignedIn()
        && canSendMessage()
        && isValidThreadCreate();
      allow update: if isSignedIn()
        && isThreadParticipant()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participant_ids']);
      allow delete: if isAdmin();
    }

    match /user_favorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.user_uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_uid == request.auth.uid;
    }

    match /follows/{followId} {
      // Lecture privée : un supporter (ou tout compte) ne lit que ses propres follows.
      // Pas de lecture publique — compteurs futurs via agrégats Cloud Functions si besoin.
      allow read: if isSignedIn() && resource.data.follower_uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.follower_uid == request.auth.uid
        && request.resource.data.target_type in ['club', 'tournament', 'player']
        && request.resource.data.target_id is string
        && request.resource.data.target_id.size() > 0;
      allow update: if isSignedIn() && resource.data.follower_uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.follower_uid == request.auth.uid;
    }

    /** Inbox parent — convocations mineurs (fallback Firestore cross-device). */
    match /guardian_notifications/{notificationId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && guardianEmail() != ''
            && resource.data.guardian_email == guardianEmail());
      allow create: if isStaffOrAdmin()
        && request.resource.data.guardian_email is string
        && request.resource.data.child_uid is string
        && request.resource.data.event_id is string
        && request.resource.data.event_title is string
        && request.resource.data.type == 'minor_invite'
        && request.resource.data.source == 'team_events';
      allow update: if isSignedIn()
        && guardianEmail() != ''
        && resource.data.guardian_email == guardianEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_at'])
        && request.resource.data.read_at is timestamp;
      allow delete: if isAdmin();
    }

    /** Compteurs publics (page Discover invité) — écriture admin uniquement */
    match /platform_stats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /** Feature flags, maintenance — lecture publique pour bannière app */
    match /platform_config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /** Fil d'actualité ProDay + sondages agents */
    match /stage_offers/{offerId} {
      allow read: if true;
      allow create: if isSignedIn()
        && canPublishStages()
        && staffCanPublishSensitive()
        && request.resource.data.author_uid == request.auth.uid
        && request.resource.data.status == 'OPEN';
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.author_uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['spots_taken', 'status', 'updated_at']));
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.author_uid == request.auth.uid);
    }

    match /stage_applications/{appId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && (resource.data.player_uid == request.auth.uid
                || resource.data.stage_author_uid == request.auth.uid));
      allow create: if isSignedIn()
        && request.resource.data.player_uid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 600;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /platform_feed/{postId} {
      allow read: if isAdmin()
        || (isSignedIn() && canReadFeedPost());
      allow create: if isSignedIn()
        && request.resource.data.author_uid == request.auth.uid
        && (
          (isAdmin()
            && request.resource.data.type == 'news'
            && request.resource.data.audience in ['all', 'agents'])
          || (request.resource.data.type == 'news'
            && isFeedAuthorRole()
            && request.resource.data.audience in ['all', 'agents'])
          || (request.resource.data.type == 'poll'
            && userDoc(request.auth.uid).data.role == 'agent'
            && request.resource.data.audience == 'agents'
            && request.resource.data.poll_options.size() >= 2)
        );
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.type == 'poll'
            && userDoc(request.auth.uid).data.role == 'agent'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['poll_votes', 'updated_at']));
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.author_uid == request.auth.uid);
    }

    match /weekly_questions/{questionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /responses/{responseUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == responseUid
          && canParticipateWeeklyQuestion()
          && request.resource.data.author_uid == request.auth.uid
          && request.resource.data.display_name is string
          && request.resource.data.author_role == userDoc(request.auth.uid).data.role
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 500;
        allow update: if isAdmin()
          || (isSignedIn()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'updated_at'])
              && request.resource.data.author_uid == resource.data.author_uid
              && request.resource.data.body == resource.data.body
              && request.resource.data.display_name == resource.data.display_name);
        allow delete: if isAdmin();
      }
    }

    /** Inscriptions bêta (site vitrine) — écriture serveur uniquement */
    match /beta_waitlist/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /** Demandes de devis sponsor — création serveur, lecture/admin envoi */
    match /sponsor_quote_requests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /** Rendez-vous pôle santé — praticien ↔ joueur */
    match /medical_appointments/{appointmentId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && (resource.data.physio_uid == request.auth.uid
                || resource.data.patient_uid == request.auth.uid));
      allow create: if isSignedIn()
        && request.resource.data.patient_uid == request.auth.uid
        && userDoc(request.auth.uid).data.role == 'player'
        && request.resource.data.status == 'pending'
        && (!('consultation_type' in request.resource.data)
            || request.resource.data.consultation_type in ['cabinet', 'visio', 'both']);
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.physio_uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'notes', 'updated_at', 'meeting_link', 'visio_provider']));
      allow delete: if isAdmin();
    }

    match /subscription_purchases/{purchaseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /** Reels communautaires — modération avant publication */
    match /community_reels/{reelId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.status == 'approved')
        || (isSignedIn() && resource.data.author_uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.author_uid == request.auth.uid
        && userDoc(request.auth.uid).data.role in ['player', 'club', 'coach']
        && request.resource.data.status == 'pending'
        && request.resource.data.theme in ['skills', 'motivation', 'nutrition'];
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isSignedIn()
            && resource.data.author_uid == request.auth.uid
            && resource.data.status == 'pending');
    }

    /** Snapshots quotidiens analytics admin */
    match /platform_stats_daily/{dayKey} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    /** Journal d'audit actions admin */
    match /admin_audit_log/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    /** Shortlist scouting club — notes staff privées */
    match /club_shortlists/{clubId}/players/{playerUid} {
      allow read: if isAdmin()
        || (isSignedIn()
            && userDoc(request.auth.uid).data.profile.club_id == clubId
            && userDoc(request.auth.uid).data.role in ['coach', 'club', 'agent', 'organizer']);
      allow create, update: if isSignedIn()
        && userDoc(request.auth.uid).data.profile.club_id == clubId
        && userDoc(request.auth.uid).data.role in ['coach', 'club', 'agent', 'organizer']
        && request.resource.data.staff_uid == request.auth.uid
        && request.resource.data.club_id == clubId;
      allow delete: if isAdmin()
        || (isSignedIn()
            && resource.data.staff_uid == request.auth.uid
            && userDoc(request.auth.uid).data.profile.club_id == clubId);
    }

    /** Signalements reels */
    match /reel_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporter_uid == request.auth.uid
        && request.resource.data.bookmark_key is string
        && request.resource.data.reason is string;
      allow update, delete: if isAdmin();
    }
  }
}
