{
  "name": "proday",
  "version": "1.0.10",
  "private": true,
  "main": "index.js",
  "description": "ProDay — plateforme mobile recrutement, tournois, matchs amicaux et sponsoring",
  "repository": {
    "type": "git",
    "url": "https://github.com/alfredgibeau-ahoussinou/PRODAY.git"
  },
  "homepage": "https://proday75.fr",
  "bugs": {
    "url": "https://github.com/alfredgibeau-ahoussinou/PRODAY/issues"
  },
  "scripts": {
    "start": "expo start",
    "start:ios": "expo start --localhost",
    "dev:ios": "expo run:ios",
    "web": "expo start --web --clear",
    "website:dev": "npm run dev --prefix website",
    "website:build": "npm run build --prefix website",
    "ios": "expo run:ios",
    "ios:sim": "bash scripts/run-ios-simulator.sh",
    "android": "expo run:android",
    "android:apk:beta": "node scripts/build-beta-apk.mjs",
    "android:apk:publish": "node scripts/publish-beta-apk.mjs",
    "desktop:install": "npm install --prefix desktop",
    "desktop:start": "npm start --prefix desktop",
    "desktop:build:win": "npm run build:win --prefix desktop",
    "desktop:build:mac": "npm run build:mac --prefix desktop",
    "typecheck": "tsc --noEmit",
    "cleanup:demo": "node scripts/cleanup-demo-data.mjs",
    "migrate:product-lines": "node scripts/migrate-product-lines.mjs",
    "migrate:joueur-pole": "node scripts/migrate-joueur-pole.mjs",
    "admin:setup": "node scripts/setup-admin.mjs",
    "auth:send-verification": "node scripts/send-verification-email.mjs",
    "auth:send-password-reset": "node scripts/send-password-reset-email.mjs",
    "test-account:setup": "node scripts/setup-test-account.mjs",
    "partner-account:setup": "node scripts/setup-partner-test-account.mjs",
    "stats:refresh": "node scripts/refresh-platform-stats.mjs",
    "firebase:health": "node scripts/firebase-health.mjs",
    "firebase:seed": "node scripts/seed-firestore.mjs",
    "seed:demo-club": "node scripts/seed-demo-club.mjs",
    "seed:demo-player": "node scripts/seed-demo-player.mjs",
    "seed:demo-parent": "node scripts/seed-demo-parent.mjs",
    "seed:demo-supporter": "node scripts/seed-demo-supporter.mjs",
    "seed:demo-review": "node scripts/seed-demo-review.mjs",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes && npm run stats:refresh",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "firebase:deploy:check": "node scripts/firebase-health.mjs",
    "fff:status": "node scripts/fff-sync-status.mjs",
    "firebase:deploy:storage": "firebase deploy --only storage",
    "firebase:rules:test": "FIREBASE_EMULATORS_PATH=\"${FIREBASE_EMULATORS_PATH:-$PWD/.firebase-emulators}\" JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk}\" PATH=\"$JAVA_HOME/bin:$PATH\" firebase emulators:exec --only firestore \"node scripts/firestore-rules.test.mjs\"",
    "beta:check": "node scripts/beta-readiness.mjs",
    "stripe:subscriptions:check": "node scripts/stripe-subscriptions-readiness.mjs",
    "beta:broadcast-ios": "node scripts/broadcast-beta-ios-pre-announcement.mjs",
    "docs:cv": "node scripts/generate-player-cv.mjs",
    "docs:pdf": "pandoc docs/ProDay_Brief_NonDev.md -o docs/ProDay_Brief_NonDev.pdf --pdf-engine=pdflatex -V lang=fr -V geometry:margin=2.2cm -V colorlinks=true -V linkcolor=003399 2>/dev/null || pandoc docs/ProDay_Brief_NonDev.md -o docs/ProDay_Brief_NonDev.pdf -V lang=fr 2>/dev/null || echo '→ Ouvrir docs/design/ProDay_Brief.html et Imprimer → PDF'",
    "docs:open-mockups": "open docs/design/mockups/index.html",
    "docs:open-brief": "open docs/design/ProDay_Brief.html",
    "intro:build": "node scripts/build-intro-video.mjs",
    "intro:build:website": "node scripts/build-website-intro-video.mjs",
    "branding:app": "node scripts/generate-app-brand.mjs --lockup assets/branding/proday-lockup-official-source.png",
    "branding:logos": "node scripts/generate-transparent-logos.mjs",
    "branding:logos:woman": "node scripts/generate-woman-logos.mjs",
    "branding:logos:universes": "node scripts/generate-universe-logos.mjs",
    "marketing:app-store-ios": "node scripts/generate-app-store-screenshots.mjs",
    "marketing:app-store-ios:legacy": "node scripts/generate-app-store-screenshots.mjs --legacy",
    "marketing:app-store-ipad": "node scripts/generate-app-store-screenshots.mjs --ipad",
    "marketing:app-store-ipad:legacy": "node scripts/generate-app-store-screenshots.mjs --ipad --legacy",
    "marketing:app-store-mac": "node scripts/generate-app-store-screenshots.mjs --mac",
    "marketing:app-store-mac:legacy": "node scripts/generate-app-store-screenshots.mjs --mac --legacy",
    "marketing:capture-supporter": "node scripts/capture-supporter-screenshot.mjs",
    "docs:pactes": "node scripts/generate-pacte-pdf.mjs",
    "docs:legal": "node --experimental-strip-types scripts/generate-legal-pdf.mjs",
    "docs:guide-restant": "node scripts/generate-guide-restant-pdf.mjs",
    "test": "jest",
    "test:e2e": "jest src/__tests__/e2e/",
    "test:e2e:maestro": "maestro test .maestro",
    "test:e2e:maestro:reels": "maestro test .maestro/reels-smoke.yaml",
    "test:e2e:maestro:reels-publish": "maestro test .maestro/reels-publish.yaml",
    "test:scale": "node scripts/scale-load-test.mjs && jest src/__tests__/scaleLoad.test.ts",
    "test:scale:firestore": "firebase emulators:exec --only firestore \"node scripts/scale-load-test.mjs --firestore && jest src/__tests__/scaleLoad.test.ts\"",
    "test:watch": "jest --watch",
    "i18n:locales": "node scripts/generate-handcraft-locales.mjs",
    "eas:build:preview": "eas build --profile preview",
    "eas:build:production": "eas build --profile production",
    "eas:build:testflight": "eas build --profile testflight --platform ios",
    "eas:build:android:apk": "eas build --profile preview --platform android",
    "eas:build:android:aab": "eas build --profile production --platform android",
    "eas:submit:production": "eas submit --profile production",
    "eas:submit:testflight": "eas submit --platform ios --latest --profile production",
    "census:fff": "node scripts/seed-fff-club-census.mjs"
  },
  "dependencies": {
    "@emailjs/nodejs": "^5.0.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo-google-fonts/syne": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-calendar": "~15.0.8",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-iap": "^4.3.1",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.11",
    "firebase": "^11.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "^1.11.0",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^3.5.3",
    "react-native-maps": "1.20.1",
    "react-native-purchases": "^10.6.0",
    "react-native-reanimated": "3.19.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "firebase-admin": "^13.10.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "react-refresh": "^0.14.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-health": {
      "@expo/config-plugins": "54.0.4"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated@~4.1.1"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-health"
        ]
      }
    },
    "autolinking": {
      "android": {
        "exclude": [
          "react-native-health"
        ]
      }
    }
  }
}
