{
  "name": "proday",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "description": "ProDay — plateforme mobile recrutement, tournois, matchs amicaux et sponsoring",
  "scripts": {
    "start": "expo start",
    "start:ios": "expo start --localhost",
    "dev:ios": "expo run:ios",
    "web": "expo start --web --clear",
    "website:dev": "npm run dev --prefix website",
    "website:build": "npm run build --prefix website",
    "ios": "expo run:ios",
    "ios:sim": "bash scripts/run-ios-simulator.sh",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "cleanup:demo": "node scripts/cleanup-demo-data.mjs",
    "migrate:product-lines": "node scripts/migrate-product-lines.mjs",
    "admin:setup": "node scripts/setup-admin.mjs",
    "test-account:setup": "node scripts/setup-test-account.mjs",
    "partner-account:setup": "node scripts/setup-partner-test-account.mjs",
    "stats:refresh": "node scripts/refresh-platform-stats.mjs",
    "firebase:health": "node scripts/firebase-health.mjs",
    "firebase:seed": "node scripts/seed-firestore.mjs",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes && npm run stats:refresh",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "firebase:deploy:check": "node scripts/firebase-health.mjs",
    "firebase:deploy:auth-email": "node scripts/deploy-auth-email-template.mjs email-verification",
    "firebase:deploy:storage": "firebase deploy --only storage",
    "firebase:rules:test": "firebase emulators:exec --only firestore \"node scripts/firestore-rules.test.mjs\"",
    "beta:check": "node scripts/beta-readiness.mjs",
    "docs:cv": "node scripts/generate-player-cv.mjs",
    "docs:pdf": "pandoc docs/ProDay_Brief_NonDev.md -o docs/ProDay_Brief_NonDev.pdf --pdf-engine=pdflatex -V lang=fr -V geometry:margin=2.2cm -V colorlinks=true -V linkcolor=003399 2>/dev/null || pandoc docs/ProDay_Brief_NonDev.md -o docs/ProDay_Brief_NonDev.pdf -V lang=fr 2>/dev/null || echo '→ Ouvrir docs/design/ProDay_Brief.html et Imprimer → PDF'",
    "docs:open-mockups": "open docs/design/mockups/index.html",
    "docs:open-brief": "open docs/design/ProDay_Brief.html",
    "branding:logos": "node scripts/generate-transparent-logos.mjs",
    "branding:logos:woman": "node scripts/generate-woman-logos.mjs",
    "branding:logos:universes": "node scripts/generate-universe-logos.mjs",
    "docs:pactes": "node scripts/generate-pacte-pdf.mjs",
    "docs:legal": "node --experimental-strip-types scripts/generate-legal-pdf.mjs",
    "docs:guide-restant": "node scripts/generate-guide-restant-pdf.mjs",
    "test": "jest",
    "test:e2e": "jest src/__tests__/e2e/",
    "test:e2e:maestro": "maestro test .maestro",
    "test:scale": "node scripts/scale-load-test.mjs && jest src/__tests__/scaleLoad.test.ts",
    "test:scale:firestore": "firebase emulators:exec --only firestore \"node scripts/scale-load-test.mjs --firestore && jest src/__tests__/scaleLoad.test.ts\"",
    "test:watch": "jest --watch",
    "i18n:locales": "node scripts/generate-handcraft-locales.mjs",
    "eas:build:preview": "eas build --profile preview",
    "eas:build:production": "eas build --profile production",
    "eas:submit:production": "eas submit --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "^56.0.19",
    "expo-calendar": "~15.0.8",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-health-connect": "^0.1.1",
    "expo-iap": "^4.3.1",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.11",
    "firebase": "^11.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^3.5.3",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "firebase-admin": "^13.10.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.2"
  }
}
