# Cloud Functions — variables d'environnement (NE PAS committer les valeurs réelles)
# Copier vers .env.proday-155b0 (gitignored) ou exporter via :
#   firebase functions:config:export
#
# Déploiement : Firebase charge automatiquement .env + .env.<projectId>

# =============================================================================
# Brevo — transport principal
# =============================================================================
EMAIL_PROVIDER=brevo
EMAIL_BREVO_API_KEY=
EMAIL_FROM_EMAIL=proday.admin@gmail.com
EMAIL_FROM_NAME=ProDay

BETA_SITE_URL=https://proday75.fr

# --- Auth (vérification + reset mot de passe) ---
AUTH_ENABLED=true
AUTH_CONTINUE_URL=https://proday75.fr

# =============================================================================
# EmailJS — repli optionnel
# =============================================================================
BETA_EMAILJS_SERVICE_ID=
BETA_EMAILJS_PUBLIC_KEY=
BETA_EMAILJS_PRIVATE_KEY=
BETA_EMAILJS_TEMPLATE_ID=
AUTH_EMAILJS_VERIFICATION_TEMPLATE_ID=
AUTH_EMAILJS_PASSWORD_RESET_TEMPLATE_ID=
APPOINTMENT_EMAILJS_TEMPLATE_ID=

# --- Cal.com visio ---
CAL_API_KEY=
CAL_EVENT_TYPE_SLUG=teleconsultation
CAL_DEFAULT_USERNAME=

# --- Daily.co visio (secours) ---
DAILY_API_KEY=
VISIO_DAILY_DOMAIN=proday

# --- Stripe (shop, tournois, cotisations + abonnements Pro + factures club admin) ---
# Checkout mode=subscription + Customer Portal (createSubscriptionCheckoutSession, createBillingPortalSession)
# Invoices club : websiteClubBillingAdmin / adminClubBilling (collection_method=send_invoice)
# Webhook stripeWebhook : checkout.session.completed, customer.subscription.updated|deleted,
#   invoice.paid|finalized|voided|payment_failed|sent (sync club_stripe_invoices)
# sk_test_ + carte 4242… pour sandbox ; sk_live_ = production (rotation si exposée)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- RevenueCat (repli App Store / Play si Stripe indisponible côté app) ---
# Authorization header value configured in RevenueCat webhook settings
REVENUECAT_WEBHOOK_AUTH=

# --- IA (Google Gemini Flash gratuit & Mistral IA) ---
GEMINI_API_KEY=
MISTRAL_API_KEY=

# =============================================================================
# SYNC CLASSEments FFF QUOTIDIEN (Cloud Functions — 04:15 Paris)
# =============================================================================
#
# National : EXTERNAL_SCORES_API_KEY (API-Football v3)
#   Déjà configuré via : firebase functions:config:set external_scores.api_key=...
#   Dashboard API-Football : https://www.api-football.com/dashboard/v3
#
# Régionaux / districts IDF : DOFA_COMPET_IDS
#   Mapping ProDay ID → identifiant numérique DOFA FFF.
#   Défini via : firebase functions:config:set dofa.compet_ids='{...}'
#
#   Exemple (IDs fictifs — À REMPLACER par les vrais IDs DOFA) :
#   firebase functions:config:set \
#     dofa.compet_ids='{"d1_d92":"425640","d2_d92":"425641","r1_idf_a":"425642","r1_idf_b":"425643","r2_idf":"425644","d1_d93":"425645","d1_d75":"425646","d1_d94":"425647","national2_c":"425648","u19_nat_a":"425649"}'
#
#   Récupérer les IDs depuis le site FFF :
#     https://www.fff.fr/competition/engagement/425640-national/
#     → le nombre dans l'URL (425640) est l'ID DOFA de la compétition.
#     Ou depuis les URLs des pages de compétitions district :
#     https://district-foot92.fff.fr/competitions/?id=XXXXXX
#
#   Sans DOFA_COMPET_IDS : les ligues district/regional écrivent un shell vide
#   honnête (standings: [], source: 'awaiting_dofa_map'), jamais de données figées.
#
# --- Identifiants API-Football (nationals) ---
# Externalisé via firebase functions:config:set external_scores.api_key=...
# (lecture dans fffStandingsSync.ts via process.env.EXTERNAL_SCORES_API_KEY)
EXTERNAL_SCORES_API_KEY=
EXTERNAL_SCORES_API_URL=https://v3.football.api-sports.io

# --- Mapping DOFA (régionaux / districts) ---
# Format JSON : { "prodayLeagueId": "doFaCompetNumericId" }
DOFA_COMPET_IDS={
  # District 92 (Hauts-de-Seine)
  "d1_d92": "",
  "d2_d92": "",
  # Régionaux IDF (Ligue Paris-Île-de-France)
  "r1_idf_a": "",
  "r1_idf_b": "",
  "r2_idf": "",
  # Districts 93, 75, 94
  "d1_d93": "",
  "d1_d75": "",
  "d1_d94": "",
  # National 2 Poule C + U19 National A
  "national2_c": "",
  "u19_nat_a": ""
}

# --- Admin alertes ---
ADMIN_ALERT_EMAIL=
