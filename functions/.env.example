# Cloud Functions — secrets serveur (NE PAS committer)
# Préférer firebase functions:config:set (voir firebase/auth-email-templates/README.md)

# --- E-mails Auth ProDay (contournement templates Console verrouillés) ---
# Transport recommandé : EmailJS (pas de DNS à vérifier — réutilise les clés bêta)
# auth.enabled=true
# auth.emailjs_template_id=template_xxx   # dédié Auth — NE PAS réutiliser beta.emailjs_template_id
# auth.emailjs_service_id=               # optionnel si identique à beta.emailjs_service_id
# auth.emailjs_public_key=               # optionnel si identique à beta.emailjs_public_key
# auth.emailjs_private_key=              # optionnel si identique à beta.emailjs_private_key
# auth.continue_url=https://proday75.fr
#
# Secours optionnel (nécessite domaine vérifié sur Resend) :
# auth.resend_api_key=re_xxxxxxxx
# auth.from_email=ProDay <contact@proday75.fr>

# --- Bêta waitlist (EmailJS) ---
# beta.emailjs_service_id=
# beta.emailjs_template_id=
# beta.emailjs_public_key=
# beta.emailjs_private_key=
# beta.site_url=https://proday75.fr

