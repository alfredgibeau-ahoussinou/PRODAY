# Cloud Functions — secrets serveur (NE PAS committer)
# Préférer firebase functions:config:set (voir docs/EMAILJS.md)

# =============================================================================
# EmailJS — transport principal (tous les e-mails utilisateur)
# =============================================================================
# Clés partagées (service + API) — une fois sous beta.*, héritées par auth/appointment
# beta.emailjs_service_id=service_xxx
# beta.emailjs_public_key=xxx
# beta.emailjs_private_key=xxx
# beta.site_url=https://proday75.fr

# --- Bêta waitlist ---
# beta.emailjs_template_id=template_xxx

# --- Auth (vérification + reset mot de passe) ---
# auth.enabled=true
# auth.emailjs_verification_template_id=template_xxx   → docs/emailjs/auth-verification.html
# auth.emailjs_password_reset_template_id=template_xxx → docs/emailjs/auth-password-reset.html
# auth.emailjs_template_id=template_xxx                # legacy (repli si IDs séparés absents)
# auth.continue_url=https://proday75.fr
# auth.emailjs_service_id=               # optionnel si identique à beta.emailjs_service_id
# auth.emailjs_public_key=               # optionnel
# auth.emailjs_private_key=              # optionnel

# --- Rendez-vous pôle Santé ---
# appointment.emailjs_template_id=template_xxx
# appointment.site_url=https://proday75.fr   # optionnel

# --- Resend (secours opt-in uniquement — désactivé par défaut) ---
# auth.resend_fallback=true
# auth.resend_api_key=re_xxxxxxxx
# auth.from_email=ProDay <contact@proday75.fr>
# beta.resend_fallback=true
# beta.resend_api_key=re_xxxxxxxx

# --- Stripe ---
# stripe.secret_key=sk_test_...
# stripe.webhook_secret=whsec_...

# --- Mistral IA ---
# mistral.api_key=
