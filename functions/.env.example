# Cloud Functions — variables d'environnement (NE PAS committer les valeurs réelles)
# Copier vers .env.proday-155b0 (gitignored) ou exporter via :
#   firebase functions:config:export
#
# Déploiement : Firebase charge automatiquement .env + .env.<projectId>

# =============================================================================
# Brevo — transport principal
# =============================================================================
EMAIL_PROVIDER=brevo
EMAIL_BREVO_API_KEY=
EMAIL_FROM_EMAIL=proday.admin@gmail.com
EMAIL_FROM_NAME=ProDay

BETA_SITE_URL=https://proday75.fr

# --- Auth (vérification + reset mot de passe) ---
AUTH_ENABLED=true
AUTH_CONTINUE_URL=https://proday75.fr

# =============================================================================
# EmailJS — repli optionnel
# =============================================================================
BETA_EMAILJS_SERVICE_ID=
BETA_EMAILJS_PUBLIC_KEY=
BETA_EMAILJS_PRIVATE_KEY=
BETA_EMAILJS_TEMPLATE_ID=
AUTH_EMAILJS_VERIFICATION_TEMPLATE_ID=
AUTH_EMAILJS_PASSWORD_RESET_TEMPLATE_ID=
APPOINTMENT_EMAILJS_TEMPLATE_ID=

# --- Cal.com visio ---
CAL_API_KEY=
CAL_EVENT_TYPE_SLUG=teleconsultation
CAL_DEFAULT_USERNAME=

# --- Daily.co visio (secours) ---
DAILY_API_KEY=
VISIO_DAILY_DOMAIN=proday

# --- Stripe (shop, tournois, cotisations + abonnements Pro récurrents) ---
# Checkout mode=subscription + Customer Portal (createSubscriptionCheckoutSession, createBillingPortalSession)
# Webhook stripeWebhook : checkout.session.completed, customer.subscription.updated|deleted
# sk_test_ + carte 4242… pour sandbox ; sk_live_ = production (rotation si exposée)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- RevenueCat (repli App Store / Play si Stripe indisponible côté app) ---
# Authorization header value configured in RevenueCat webhook settings
REVENUECAT_WEBHOOK_AUTH=

# --- Mistral IA ---
MISTRAL_API_KEY=

# --- Admin alertes ---
ADMIN_ALERT_EMAIL=

# --- Supporter Space V3 — Sportmonks (proxy callable supporterFootballProxy) ---
# SPORTMONKS_API_TOKEN=
# FOOTBALL_API_KEY=   # alias accepté
