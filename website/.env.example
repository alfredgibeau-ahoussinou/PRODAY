# =============================================================================
# EmailJS — ProDay (Netlify, variables serveur uniquement)
# Guide complet : docs/EMAILJS.md
# =============================================================================

# Clés partagées EmailJS (bêta — le site proxy vers Cloud Function Firebase)
EMAILJS_SERVICE_ID=service_xxxxx
EMAILJS_TEMPLATE_ID=template_xxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxx

# Templates Firebase (référence — configurés via firebase functions:config:set)
# auth.emailjs_verification_template_id=template_auth_verif_xxx → docs/emailjs/auth-verification.html
# auth.emailjs_password_reset_template_id=template_auth_reset_xxx → docs/emailjs/auth-password-reset.html
# auth.emailjs_template_id=template_auth_xxx      → docs/emailjs/auth-action.html (legacy)
# appointment.emailjs_template_id=template_rdv_xxx → docs/emailjs/appointment.html

NEXT_PUBLIC_SITE_URL=https://proday75.fr

# Hub portfolio-analytics (stats centralisées — voir ~/portfolio-analytics)
NEXT_PUBLIC_PORTFOLIO_ANALYTICS_URL=http://localhost:3001
NEXT_PUBLIC_PORTFOLIO_ANALYTICS_SITE_KEY=proday

# Optionnel — liens de téléchargement affichés sur /beta (sinon « bientôt » + email)
NEXT_PUBLIC_BETA_APK_URL=https://storage.googleapis.com/proday-155b0.firebasestorage.app/beta/proday-beta.apk
# TestFlight — affiché sur le site uniquement après le 11 août 2026 à 18 h (Europe/Paris)
# NEXT_PUBLIC_BETA_TESTFLIGHT_URL=https://testflight.apple.com/join/…

# Cloud Functions Firebase (inscription bêta + validation token + devis sponsor)
# BETA_WAITLIST_FUNCTION_URL=https://europe-west1-proday-155b0.cloudfunctions.net/submitBetaWaitlist
# BETA_VALIDATE_FUNCTION_URL=https://europe-west1-proday-155b0.cloudfunctions.net/validateBetaAccess
# SPONSOR_QUOTE_FUNCTION_URL=https://europe-west1-proday-155b0.cloudfunctions.net/submitSponsorQuoteRequest

# =============================================================================
# Admin fondateurs — espace /admin (minicode, jamais NEXT_PUBLIC_*)
# =============================================================================
# Minicode partagé (4 fondateurs) — placeholder local uniquement
BETA_ADMIN_PIN=CHANGEME
# Alias accepté : ADMIN_MINICODE=CHANGEME
# Secret HMAC session cookie (≥ 16 caractères) — distinct du PIN
BETA_ADMIN_SESSION_SECRET=change-me-session-secret-32chars
# Proxy vers Cloud Function websiteBetaWaitlistAdmin
# BETA_WAITLIST_ADMIN_FUNCTION_URL=https://europe-west1-proday-155b0.cloudfunctions.net/websiteBetaWaitlistAdmin
# Même secret côté Firebase (functions config / env)
# BETA_WEBSITE_ADMIN_SECRET=change-me-shared-admin-api-secret
# Tracking visites (optionnel — URL par défaut europe-west1 / proday-155b0)
# TRAFFIC_VISIT_FUNCTION_URL=https://europe-west1-proday-155b0.cloudfunctions.net/recordTrafficVisit
# TRAFFIC_STATS_ADMIN_FUNCTION_URL=https://europe-west1-proday-155b0.cloudfunctions.net/websiteTrafficStatsAdmin

# Téléconsultation : pas d’embed global — chaque praticien Santé connecte son Cal.com
# (fiche praticien / annuaire). Ne pas brancher un calendrier personnel fondateur.
